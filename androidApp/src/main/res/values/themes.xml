<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The splash theme is the *application* theme, handed over to the real one by the
      SplashScreen API once the first frame is ready. Declaring a separate theme and switching it
      in code would leave the system-drawn starting window looking like neither.

      The glyph is the same transparent-background export the iOS launch screen uses, on the same
      background — so the splash reads as a continuation of the icon rather than as a second,
      differently-styled screen.
    -->
    <style name="Theme.DriveMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveMusic</item>
    </style>

    <style name="Theme.DriveMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
